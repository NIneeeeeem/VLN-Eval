{
  "schema_version": "nav-eval-plugin/1",
  "kind": "method",
  "id": "streamvln",
  "version": "1",
  "entrypoint": "extensions.methods.streamvln.adapter:create",
  "settings": ["preprocess_mode", "tokenizer_mode"],
  "defaults": {"preprocess_mode": "lazy", "tokenizer_mode": "reuse"},
  "observation": {
    "width": 640,
    "height": 480,
    "hfov": 79
  },
  "capabilities": {
    "requires_sensors": [
      "rgb"
    ],
    "emits_actions": [
      "primitive",
      "stop"
    ]
  },
  "action_semantics": {
    "forward_m": 0.25,
    "turn_rad": 0.2617993877991494
  },
  "requires": {
    "gpu": true,
    "paths": [
      "checkpoint",
      "repo_path"
    ]
  },
  "validation": {
    "level": "unverified"
  }
}
