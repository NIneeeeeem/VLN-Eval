{
  "schema_version": "nav-eval-plugin/1",
  "kind": "benchmark",
  "id": "instance_imagenav",
  "version": "1",
  "default_simulator": "habitat030",
  "goal_kinds": ["image_reference"],
  "splits": ["instance_imagenav_hm3d_val", "instance_imagenav_hm3d_val_mini"],
  "defaults": {"benchmark_id": "instance_imagenav_hm3d_val", "success_distance_m": 0.1},
  "settings": ["benchmark_id", "success_distance_m", "simulator_version"],
  "observation": {"width": 640, "height": 480, "hfov": 90, "sensors": ["rgb", "depth", "instance_imagegoal"]},
  "bindings": {"habitat024": {
    "entrypoint": "extensions.benchmarks.imagenav.instance_imagenav.bindings.habitat:create",
    "accepts_actions": ["primitive", "camera_tilt", "stop"],
    "offers_sensors": ["instance_imagegoal"],
    "requires_sensors": ["instance_imagegoal"],
    "requires_goal_declaration": true,
    "capture_schema": "habitat-instance-imagenav-evidence/1",
    "provides_evidence": ["trajectory.goal_distances_m", "trajectory.positions_xyz_m", "reference.geodesic_start_to_goal_m", "reference.success_radius_m"],
    "clock": "discrete_control_ticks",
    "action_semantics": {"forward_m": 0.25, "turn_rad": 0.5235987755982988, "camera_tilt_rad": 0.5235987755982988},
    "settings": {"simulator_version": "0.2.4"}
  }, "habitat030": {
    "entrypoint": "extensions.benchmarks.imagenav.instance_imagenav.bindings.habitat:create",
    "accepts_actions": ["primitive", "camera_tilt", "stop"],
    "offers_sensors": ["instance_imagegoal"],
    "requires_sensors": ["instance_imagegoal"],
    "requires_goal_declaration": true,
    "capture_schema": "habitat-instance-imagenav-evidence/1",
    "provides_evidence": ["trajectory.goal_distances_m", "trajectory.positions_xyz_m", "reference.geodesic_start_to_goal_m", "reference.success_radius_m"],
    "clock": "discrete_control_ticks",
    "action_semantics": {"forward_m": 0.25, "turn_rad": 0.5235987755982988, "camera_tilt_rad": 0.5235987755982988},
    "settings": {"simulator_version": "0.3.0"}
  }},
  "metrics": ["instance_imagenav_standard"],
  "failure_policy": {"policy_error": "diagnostic_only", "infrastructure_error": "diagnostic_only"},
  "validation": {"level": "unverified"}
}
