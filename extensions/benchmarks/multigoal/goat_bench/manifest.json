{
  "schema_version": "nav-eval-plugin/1",
  "kind": "benchmark",
  "id": "goat_bench",
  "version": "1",
  "default_simulator": "habitat024",
  "goal_kinds": [
    "goal_sequence"
  ],
  "splits": [
    "goat_hm3d_val_seen",
    "goat_hm3d_val_unseen"
  ],
  "defaults": {
    "benchmark_id": "goat_bench",
    "simulator_version": "0.2.4",
    "sensors": [
      "rgb",
      "depth",
      "task_goal",
      "goal_embedding"
    ],
    "max_episode_steps": 5000
  },
  "settings": [
    "benchmark_id",
    "repo_root",
    "task_config",
    "dataset_path",
    "episode_limit",
    "episode_ids",
    "gpu_device_id",
    "sensors",
    "max_episode_steps",
    "simulator_version",
    "asset_paths",
    "camera_tilt"
  ],
  "observation": {
    "width": 640,
    "height": 360,
    "hfov": 90
  },
  "bindings": {
    "habitat024": {
      "requires": {"modules": ["goat_bench"]},
      "entrypoint": "extensions.benchmarks.multigoal.goat_bench.bindings.habitat:create",
      "accepts_actions": [
        "primitive",
        "camera_tilt",
        "stop"
      ],
      "offers_sensors": [
        "rgb",
        "depth",
        "task_goal",
        "goal_embedding"
      ],
      "requires_sensors": [
        "task_goal",
        "goal_embedding"
      ],
      "capture_schema": "upstream-habitat-captured-metrics/1",
      "provides_evidence": [
        "upstream_metrics_by_tick"
      ],
      "clock": "discrete_control_ticks",
      "action_semantics": {
        "forward_m": 0.25,
        "turn_rad": 0.5235987755982988,
        "camera_tilt_rad": 0.5235987755982988
      },
      "settings": {
        "simulator_version": "0.2.4"
      },
      "requires_goal_declaration": true
    },
    "habitat030": {
      "requires": {"modules": ["goat_bench"]},
      "entrypoint": "extensions.benchmarks.multigoal.goat_bench.bindings.habitat:create",
      "accepts_actions": ["primitive", "stop"],
      "offers_sensors": ["rgb", "depth", "task_goal", "goal_embedding"],
      "requires_sensors": ["task_goal", "goal_embedding"],
      "capture_schema": "upstream-habitat-captured-metrics/1",
      "provides_evidence": ["upstream_metrics_by_tick"],
      "clock": "discrete_control_ticks",
      "action_semantics": {"forward_m": 0.25, "turn_rad": 0.5235987755982988},
      "settings": {"simulator_version": "0.3.0", "camera_tilt": false},
      "requires_goal_declaration": true
    }
  },
  "metrics": [
    "goat_captured"
  ],
  "failure_policy": {
    "policy_error": "diagnostic_only",
    "infrastructure_error": "diagnostic_only"
  },
  "validation": {
    "level": "unverified"
  }
}
