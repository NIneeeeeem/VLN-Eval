{
  "schema_version": "nav-eval-plugin/1",
  "kind": "benchmark",
  "id": "vlnverse",
  "version": "1",
  "default_simulator": "isaacsim500",
  "splits": ["vlnverse_fine_val_unseen", "vlnverse_coarse_val_unseen"],
  "defaults": {
    "benchmark_id": "vlnverse_fine_val_unseen",
    "success_distance_m": 3,
    "max_control_steps": 500,
    "max_task_steps": 25000,
    "enable_oracle": false
  },
  "settings": [
    "benchmark_id",
    "success_distance_m",
    "max_control_steps",
    "max_task_steps",
    "enable_oracle",
    "languages",
    "simulator_version"
  ],
  "observation": {
    "width": 640,
    "height": 480,
    "hfov": 90
  },
  "bindings": {
    "isaacsim500": {
      "fixed_geometry": {"hfov": 90},
      "entrypoint": "extensions.benchmarks.vlnverse.bindings.isaac:create",
      "accepts_actions": [
        "primitive",
        "stop"
      ],
      "capture_schema": "vlnverse-evidence/2",
      "provides_evidence": [
        "trajectory.metric_positions_xyz_m",
        "trajectory.path_length_m",
        "trajectory.positions_xyz_m",
        "reference.goal_xyz_m",
        "reference.geodesic_start_to_goal_m",
        "reference.success_radius_m",
        "reference.reference_path_xyz_m"
      ],
      "clock": "discrete_control_ticks",
      "action_semantics": {
        "forward_m": 0.25,
        "turn_rad": 0.2617993877991494
      },
      "settings": {}
    }
  },
  "metrics": [
    "vlnverse_standard"
  ],
  "failure_policy": {
    "policy_error": "diagnostic_only",
    "infrastructure_error": "diagnostic_only"
  },
  "validation": {
    "level": "unverified"
  }
}
